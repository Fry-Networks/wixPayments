{
  "name": "wix-payments-service",
  "version": "2.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "op run --env-file ./.1p.env.dev -- nodemon --exec \"node --import ./register-ts-node.js\" src/main.ts",
    "start": "op run --env-file ./.1p.env.prod -- node build/main.js",
    "build": "tsc && mkdir -p build/config && cp src/config/HTMLtemplate.html build/config/",
    "start:build": "npm run build && npm run start",
    "test": "op run --env-file ./.1p.env.dev -- echo \"Error: no test specified\" && exit 1",
    "ai-miner-cli": "op run --env-file ./.1p.env.dev -- node --import ./register-ts-node.js src/ai-edge-miner/run-cli.ts",
    "ai-miner-cli:v2": "op run --env-file ./.1p.env.dev -- node --import ./register-ts-node.js src/ai-edge-miner-2/cli/index.ts",
    "ai-miner-cli:build": "op run --env-file ./.1p.env.prod -- tsc && node build/ai-edge-miner/run-cli.js",
    "sync": "git pull && tsc && op run --env-file ./.1p.env.prod -- pm2 restart wix_listen"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.4.0",
    "express": "^4.18.2",
    "googleapis": "^122.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.4.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.4",
    "randomstring": "^1.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.11",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.8",
    "@types/randomstring": "^1.1.8",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
